# ==============================================================================
# Food Diary Environment Configuration Template
# Copy this file to .env and adjust variables as necessary for your environment.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Hostinger cPanel MySQL credentials)
# Set DB_HOST to localhost (when deployed on Hostinger Node.js app) or your Hostinger server IP/domain
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Database Driver & Pool Tuning
# DB_DRIVER can be 'mysql' (default) or 'sqlite' (force local zero-dependency embedded database)
DB_DRIVER=mysql
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=3000

# SQLite Fallback Configuration (Used automatically if MySQL is unreachable or if DB_DRIVER=sqlite)
SQLITE_DB_PATH=database/food_records_dev.sqlite
