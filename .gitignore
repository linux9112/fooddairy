# ==============================================================================
# Food Diary — Git Ignore Configuration
# ==============================================================================

# Node dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (CRITICAL: Never commit passwords or credentials)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Preserve example environment template
!.env.example

# Production build outputs
dist/
dist-ssr/
client/dist/
build/
out/

# Bundler & cache directories
.cache/
.vite/
.turbo/
*.tsbuildinfo

# SQLite fallback database files & journals
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
database/*.sqlite
database/*.db

# System-generated / Agent temp files
.agents/
.system_generated/
temp/
tmp/
*.tmp
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & coverage artifacts
coverage/
.nyc_output/
test-results/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
